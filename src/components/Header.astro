---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
interface Props { current?: string }
const { current = '' } = Astro.props;
const nav = [
  { href: '/paths/', label: 'Paths', key: 'paths' },
  { href: '/roadmaps/', label: 'Roadmaps', key: 'roadmaps' },
  { href: '/resources/', label: 'Resources', key: 'resources' },
  { href: '/certifications/', label: 'Certifications', key: 'certifications' },
  { href: '/connect/', label: 'Connect', key: 'connect' },
];
---
<header class="sticky top-0 z-40 w-full border-b border-line bg-ink/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <Logo />
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {nav.map((n) => (
        <a
          href={n.href}
          aria-current={current === n.key ? 'page' : undefined}
          class="inline-flex min-h-10 items-center rounded-full px-3.5 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-text aria-[current=page]:text-text aria-[current=page]:bg-surface-2"
        >{n.label}</a>
      ))}
      <a href="https://karmatix.in" class="ml-1 inline-flex min-h-10 items-center gap-1 rounded-full px-3 text-sm text-dim transition-colors hover:text-text">
        karmatix.in <Icon name="arrow-up-right" class="size-3.5" />
      </a>
      <a href="/#paths" class="kx-btn kx-btn-primary ml-2 !min-h-10 !px-4 text-sm">Pick a path</a>
    </nav>
    <button
      id="kx-menu-btn"
      type="button"
      class="inline-flex size-11 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-line-strong hover:text-text lg:hidden"
      aria-expanded="false"
      aria-controls="kx-menu"
      aria-label="Open menu"
    >
      <Icon name="menu" class="size-5 kx-menu-open" />
      <Icon name="x" class="size-5 kx-menu-close hidden" />
    </button>
  </div>
  <nav id="kx-menu" class="hidden border-t border-line bg-surface px-4 pb-5 pt-2 lg:hidden" aria-label="Mobile">
    <ul class="flex flex-col">
      {nav.map((n) => (
        <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined} class="flex min-h-12 items-center justify-between border-b border-line text-base font-medium text-text aria-[current=page]:text-ember">{n.label}<Icon name="arrow-right" class="size-4 text-dim" /></a></li>
      ))}
      <li><a href="/support/" class="flex min-h-12 items-center justify-between border-b border-line text-base font-medium text-text">Support Karmatix<Icon name="heart" class="size-4 text-dim" /></a></li>
      <li><a href="https://karmatix.in" class="flex min-h-12 items-center justify-between text-base text-muted">karmatix.in<Icon name="arrow-up-right" class="size-4 text-dim" /></a></li>
    </ul>
    <a href="/#paths" class="kx-btn kx-btn-primary mt-3 w-full">Pick a path</a>
  </nav>
</header>
<script>
  const btn = document.getElementById('kx-menu-btn');
  const menu = document.getElementById('kx-menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      btn.querySelector('.kx-menu-open')?.classList.toggle('hidden', open);
      btn.querySelector('.kx-menu-close')?.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () => set(menu.classList.contains('hidden')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.classList.contains('hidden')) { set(false); btn.focus(); } });
  }
</script>
