---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { paths, LAST_CHECKED } from '../lib/data';
---
<footer class="mt-24 border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div class="max-w-xs">
      <Logo />
      <p class="mt-3 text-sm leading-relaxed text-dim">A hand-picked map of what to learn, where to practise and who to learn with. Made in India by Karmatix.</p>
      <p class="mt-4 text-xs text-dim">Links checked <span class="num">{LAST_CHECKED}</span>. No affiliate links.</p>
    </div>
    <nav aria-label="Paths">
      <h2 class="text-sm font-semibold text-text">Paths</h2>
      <ul class="mt-3 space-y-1">
        {paths.map((p) => <li><a class="inline-flex min-h-9 items-center text-sm text-muted transition-colors hover:text-text" href={`/paths/${p.id}/`}>{p.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Explore">
      <h2 class="text-sm font-semibold text-text">Explore</h2>
      <ul class="mt-3 space-y-1">
        <li><a class="inline-flex min-h-9 items-center text-sm text-muted hover:text-text" href="/roadmaps/">Stack roadmaps</a></li>
        <li><a class="inline-flex min-h-9 items-center text-sm text-muted hover:text-text" href="/resources/">All resources</a></li>
        <li><a class="inline-flex min-h-9 items-center text-sm text-muted hover:text-text" href="/certifications/">Certifications</a></li>
        <li><a class="inline-flex min-h-9 items-center text-sm text-muted hover:text-text" href="/connect/">Connect with developers</a></li>
        <li><a class="inline-flex min-h-9 items-center text-sm text-muted hover:text-text" href="/#courses">Karmatix practice</a></li>
      </ul>
    </nav>
    <nav aria-label="Karmatix">
      <h2 class="text-sm font-semibold text-text">Karmatix</h2>
      <ul class="mt-3 space-y-1">
        <li><a class="inline-flex min-h-9 items-center gap-1 text-sm text-muted hover:text-text" href="https://karmatix.in">karmatix.in <Icon name="arrow-up-right" class="size-3.5" /></a></li>
        <li><a class="inline-flex min-h-9 items-center text-sm text-muted hover:text-text" href="/support/">Support us</a></li>
        <li><a class="inline-flex min-h-9 items-center gap-1 text-sm text-muted hover:text-text" href="https://github.com/Karma-tic/karmatix-learn/issues/new?title=Suggest%20a%20resource">Suggest a resource <Icon name="arrow-up-right" class="size-3.5" /></a></li>
        <li><a class="inline-flex min-h-9 items-center text-sm text-muted hover:text-text" href="/privacy/">Privacy</a></li>
        <li><a class="inline-flex min-h-9 items-center text-sm text-muted hover:text-text" href="/terms/">Terms</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-dim sm:px-6">&copy; <span class="num">2026</span> Karmatix. Names and logos of courses, platforms and certifications belong to their owners. We are not affiliated with or paid by them.</p>
  </div>
</footer>
