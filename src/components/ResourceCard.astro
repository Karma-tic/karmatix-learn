---
import Icon from './Icon.astro';
import { TYPES, COST, LEVEL, LANG, TRACKS, host, type Resource } from '../lib/data';
interface Props { r: Resource; variant?: 'full' | 'compact'; headingLevel?: 'h3' | 'h4'; showTip?: boolean }
const { r, variant = 'full', headingLevel = 'h3', showTip = true } = Astro.props;
const t = TYPES[r.type];
const H = headingLevel;
const costClass = r.cost === 'free' ? 'kx-tag-free' : r.cost === 'paid' ? 'kx-tag-paid' : '';
---
{variant === 'full' ? (
  <article
    class="kx-card kx-card-link relative flex h-full flex-col p-5"
    data-res
    data-type={r.type}
    data-cost={r.cost}
    data-tracks={r.tracks.join(' ')}
    data-india={r.india ? '1' : '0'}
    data-lang={r.lang}
    data-text={`${r.name} ${r.by} ${r.why} ${t.label} ${r.tracks.map((x) => TRACKS[x]).join(' ')}`.toLowerCase()}
  >
    <div class="flex items-center justify-between gap-3">
      <span class="inline-flex items-center gap-1.5 text-xs font-medium text-dim"><Icon name={t.icon} class="size-4 text-ember" />{t.label}</span>
      <Icon name="arrow-up-right" class="kx-arrow size-4 text-dim" />
    </div>
    <H class="mt-3 text-[1.05rem] font-semibold leading-snug text-text">
      <a href={r.url} class="kx-stretch rounded-sm" rel="noopener">{r.name}<span class="sr-only"> (opens {host(r.url)})</span></a>
    </H>
    <p class="mt-0.5 text-xs text-dim">{r.by === host(r.url) ? r.by : `${r.by}, ${host(r.url)}`}</p>
    <p class="mt-3 text-sm leading-relaxed text-muted">{r.why}</p>
    {showTip && <p class="mt-3 border-l-2 border-ember/60 pl-3 text-sm leading-relaxed text-text/90"><span class="sr-only">How to use it: </span>{r.tip}</p>}
    <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
      <span class={`kx-tag ${costClass}`}>{COST[r.cost]}</span>
      {r.price && <span class="kx-tag">{r.price}</span>}
      <span class="kx-tag">{LEVEL[r.level]}</span>
      {r.lang !== 'en' && <span class="kx-tag kx-tag-ember"><Icon name="languages" class="size-3" />{LANG[r.lang]}</span>}
      {r.india && r.lang === 'en' && <span class="kx-tag kx-tag-ember">India</span>}
    </div>
  </article>
) : (
  <article class="kx-card kx-card-link relative flex gap-3 p-4">
    <span class="mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-surface-3 text-ember"><Icon name={t.icon} class="size-4" /></span>
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-2">
        <H class="text-[0.95rem] font-semibold leading-snug text-text">
          <a href={r.url} class="kx-stretch rounded-sm" rel="noopener">{r.name}<span class="sr-only"> (opens {host(r.url)})</span></a>
        </H>
        <Icon name="arrow-up-right" class="kx-arrow mt-0.5 size-4 shrink-0 text-dim" />
      </div>
      <p class="mt-0.5 text-xs text-dim">{[t.label, COST[r.cost], r.lang !== 'en' ? LANG[r.lang] : null].filter(Boolean).join(', ')}</p>
      {showTip && <p class="mt-2 text-sm leading-relaxed text-muted">{r.tip}</p>}
    </div>
  </article>
)}
