---
import coursesData from '../data/courses.json';

const flagship = coursesData.find((c) => c.flagship);
const flutter = coursesData.find((c) => c.id === 'flutter-course');
const upcoming = coursesData.filter((c) => c.status === 'planned');
---

<section id="courses" class="py-16 md:py-24 border-b border-[#1e293b]">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#1e293b] bg-[#111827] px-3 py-1 text-xs font-semibold text-[#60a5fa] mb-3">
        <span>CURRICULUM CATALOG</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#f8fafc] tracking-tight">
        Engineered for job readiness and deep fundamentals.
      </h2>
      <p class="mt-2 text-sm sm:text-base text-[#94a3b8] max-w-2xl">
        Every course is complete, free, and built on tested code with no paywalls or sign-up gates.
      </p>
    </div>

    <!-- Bento Grid (Strict 5 items = 5 cells, 0 filler) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- 1. Flagship Cell: .NET Academy (7 cols) -->
      {flagship && (
        <article class="lg:col-span-7 flex flex-col justify-between rounded-lg border border-[#334155] bg-[#111827] p-6 transition-all hover:border-[#60a5fa]">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#2563eb]/20 px-3 py-1 text-xs font-semibold text-[#60a5fa] border border-[#2563eb]/30">
                <span class="h-1.5 w-1.5 rounded-full bg-[#2563eb]"></span>
                Flagship Course
              </span>
              <span class="text-xs font-medium text-[#64748b]">{flagship.level}</span>
            </div>

            <h3 class="text-2xl font-bold text-[#f8fafc] mb-2">
              <a href={flagship.url} class="hover:text-[#60a5fa] transition-colors focus:outline-none">
                {flagship.title}
              </a>
            </h3>
            <p class="text-sm text-[#94a3b8] mb-6 leading-relaxed">
              {flagship.summary}
            </p>

            <!-- Verified Stats Matrix -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6 p-3 rounded-lg bg-[#0b0f19] border border-[#1e293b]">
              {flagship.stats.map((s) => (
                <div>
                  <div class="text-base sm:text-lg font-bold text-[#f8fafc] font-mono">{s.value}</div>
                  <div class="text-[11px] text-[#64748b] leading-tight">{s.label}</div>
                </div>
              ))}
            </div>

            <!-- Real Screenshot Preview -->
            <div class="rounded-lg overflow-hidden border border-[#1e293b] mb-6 bg-[#0b0f19]">
              <picture>
                <source srcset={flagship.image.desktopAvif} type="image/avif" />
                <source srcset={flagship.image.desktop} type="image/webp" />
                <img
                  src={flagship.image.desktop.replace('.webp', '.png')}
                  alt={flagship.image.alt}
                  width="1200"
                  height="750"
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
              </picture>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[#1e293b]">
            <div class="flex flex-wrap gap-1.5">
              {flagship.topics.slice(0, 4).map((topic) => (
                <span class="rounded bg-[#0b0f19] px-2 py-0.5 text-[11px] text-[#94a3b8] border border-[#1e293b]">
                  {topic}
                </span>
              ))}
            </div>
            <a
              href={flagship.url}
              class="inline-flex h-10 items-center justify-center rounded-full bg-[#2563eb] px-5 text-xs font-semibold text-white transition-colors hover:bg-[#1d4ed8]"
            >
              Start learning
            </a>
          </div>
        </article>
      )}

      <!-- 2. Live Cell: Flutter Course (5 cols) -->
      {flutter && (
        <article class="lg:col-span-5 flex flex-col justify-between rounded-lg border border-[#1e293b] bg-[#111827] p-6 transition-all hover:border-[#334155]">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/20 px-3 py-1 text-xs font-semibold text-emerald-400 border border-emerald-500/30">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                Live Course
              </span>
              <span class="text-xs font-medium text-[#64748b]">{flutter.level}</span>
            </div>

            <h3 class="text-2xl font-bold text-[#f8fafc] mb-2">
              <a href={flutter.url} class="hover:text-[#60a5fa] transition-colors focus:outline-none">
                {flutter.title}
              </a>
            </h3>
            <p class="text-sm text-[#94a3b8] mb-6 leading-relaxed">
              {flutter.summary}
            </p>

            <!-- Verified Stats Matrix -->
            <div class="grid grid-cols-2 gap-3 mb-6 p-3 rounded-lg bg-[#0b0f19] border border-[#1e293b]">
              {flutter.stats.map((s) => (
                <div>
                  <div class="text-base font-bold text-[#f8fafc] font-mono">{s.value}</div>
                  <div class="text-[11px] text-[#64748b] leading-tight">{s.label}</div>
                </div>
              ))}
            </div>

            <!-- Real Screenshot Preview -->
            <div class="rounded-lg overflow-hidden border border-[#1e293b] mb-6 bg-[#0b0f19]">
              <picture>
                <source srcset={flutter.image.desktopAvif} type="image/avif" />
                <source srcset={flutter.image.desktop} type="image/webp" />
                <img
                  src={flutter.image.desktop.replace('.webp', '.png')}
                  alt={flutter.image.alt}
                  width="1200"
                  height="750"
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
              </picture>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[#1e293b]">
            <div class="flex flex-wrap gap-1.5">
              {flutter.topics.slice(0, 3).map((topic) => (
                <span class="rounded bg-[#0b0f19] px-2 py-0.5 text-[11px] text-[#94a3b8] border border-[#1e293b]">
                  {topic}
                </span>
              ))}
            </div>
            <a
              href={flutter.url}
              class="inline-flex h-10 items-center justify-center rounded-full bg-[#2563eb] px-5 text-xs font-semibold text-white transition-colors hover:bg-[#1d4ed8]"
            >
              Start learning
            </a>
          </div>
        </article>
      )}

      <!-- 3, 4, 5. Upcoming Courses (3 cards, 4 cols each = 12 cols total) -->
      {upcoming.map((course) => (
        <article class="lg:col-span-4 flex flex-col justify-between rounded-lg border border-[#1e293b] bg-[#111827] p-5 transition-all hover:border-[#334155]">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-800 px-2.5 py-0.5 text-[11px] font-semibold text-[#94a3b8] border border-slate-700">
                <span class="h-1.5 w-1.5 rounded-full bg-[#64748b]"></span>
                In development
              </span>
              <span class="text-[11px] text-[#64748b]">{course.level}</span>
            </div>

            <h3 class="text-lg font-bold text-[#f8fafc] mb-2 leading-snug">
              {course.title}
            </h3>
            <p class="text-xs text-[#94a3b8] mb-4 leading-relaxed">
              {course.summary}
            </p>

            <!-- Real Code Snippet Texture -->
            {course.codeSnippet && (
              <div class="rounded-lg bg-[#0b0f19] border border-[#1e293b] p-3 mb-4 font-mono text-[11px] overflow-x-auto text-[#94a3b8]">
                <div class="text-[10px] text-[#64748b] border-b border-[#1e293b] pb-1 mb-2 font-sans font-medium">
                  {course.codeSnippet.title}
                </div>
                <pre class="whitespace-pre text-slate-300"><code>{course.codeSnippet.code}</code></pre>
              </div>
            )}
          </div>

          <div class="flex items-center justify-between pt-3 border-t border-[#1e293b] text-xs">
            <span class="text-[#64748b]">No fake dates</span>
            <a
              href={course.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-[#60a5fa] hover:underline inline-flex items-center gap-1"
            >
              <span>Follow progress on GitHub</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      ))}

    </div>

    <!-- Ko-fi Chai Support Callout -->
    <div class="mt-8 rounded-xl border border-[#1e293b] bg-[#111827] p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-500/10 text-lg text-blue-400 shrink-0" aria-hidden="true">
          ☕
        </span>
        <div>
          <p class="text-sm font-semibold text-[#f8fafc]">
            Enjoying these free engineering courses?
          </p>
          <p class="text-xs text-[#94a3b8]">
            Every curriculum is free with no paywalls or user tracking. Donations help pay for cloud hosting, CI test runners, and domain renewals.
          </p>
        </div>
      </div>
      <a
        href="https://ko-fi.com/karmatix"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-1.5 rounded-full bg-[#2563eb] px-4 py-2 text-xs font-semibold text-white hover:bg-[#1d4ed8] transition-colors shadow-sm"
        aria-label="Buy me a chai on Ko-fi (opens in a new tab)"
      >
        <span>Buy me a chai ☕</span>
      </a>
    </div>
  </div>
</section>

