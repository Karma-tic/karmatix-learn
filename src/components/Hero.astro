---
---

<section class="relative overflow-hidden pt-8 pb-16 md:pt-12 md:pb-24 border-b border-[#1e293b]">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Left Column: Copy & CTAs (Max 4 text elements, budget compliant) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- 1. Eyebrow -->
        <div class="inline-flex items-center gap-2 rounded-full border border-[#1e293b] bg-[#111827] px-3 py-1 text-xs font-semibold text-[#60a5fa] mb-4">
          <span class="h-1.5 w-1.5 rounded-full bg-[#2563eb]"></span>
          <span>OPEN ENGINEERING CATALOG</span>
        </div>

        <!-- 2. Headline (Max 2 lines) -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[#f8fafc] leading-[1.15] mb-4">
          Engineering education with code that actually runs.
        </h1>

        <!-- 3. Subtext (Max 20 words: exactly 15 words) -->
        <p class="text-base sm:text-lg text-[#94a3b8] leading-relaxed mb-6 max-w-xl">
          Free software engineering courses built on real tested projects. No accounts or sign-ups required.
        </p>

        <!-- 4. CTA Group (Primary CTA visible on 360x640) -->
        <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto mb-8">
          <a
            href="#courses"
            class="inline-flex h-12 w-full sm:w-auto items-center justify-center rounded-full bg-[#2563eb] px-6 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[#1d4ed8] focus-visible:outline-none"
          >
            View courses
          </a>
          <a
            href="https://karma-tic.github.io/dotnet-academy/"
            class="inline-flex h-12 w-full sm:w-auto items-center justify-center rounded-full border border-[#334155] bg-[#111827] px-6 text-sm font-semibold text-[#f8fafc] transition-colors hover:border-[#60a5fa] hover:text-[#60a5fa]"
          >
            Start with .NET
          </a>
        </div>

        <!-- Trust Pills -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs text-[#94a3b8] font-medium pt-2 border-t border-[#1e293b] w-full">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-[#111827] border border-[#1e293b] px-3 py-1">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            100% free
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-[#111827] border border-[#1e293b] px-3 py-1">
            <svg class="w-3.5 h-3.5 text-[#60a5fa]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Real compilable code
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-[#111827] border border-[#1e293b] px-3 py-1">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            No ads, no trackers
          </span>
        </div>
      </div>

      <!-- Right Column: Signature Moment (CSS-Only Scroll-Driven Overlapping Screenshots) -->
      <div class="lg:col-span-5 relative mt-6 lg:mt-0 flex items-center justify-center">
        <div class="relative w-full max-w-lg aspect-[4/3] rounded-lg p-2 flex items-center justify-center">
          
          <!-- Background Screenshot: .NET Academy Desktop -->
          <div class="absolute left-0 top-0 w-4/5 rounded-lg border border-[#334155] bg-[#111827] shadow-2xl overflow-hidden scroll-reveal-back">
            <div class="flex items-center gap-1.5 px-3 py-2 bg-[#0b0f19] border-b border-[#1e293b]">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
              <span class="text-[10px] text-[#64748b] ml-2 font-mono">karma-tic.github.io/dotnet-academy</span>
            </div>
            <picture>
              <source srcset="/images/courses/dotnet-desktop.avif" type="image/avif" />
              <source srcset="/images/courses/dotnet-desktop.webp" type="image/webp" />
              <img
                src="/images/courses/dotnet-desktop.png"
                alt="Real screenshot of Karmatix .NET Academy course interface"
                width="1200"
                height="750"
                class="w-full h-auto object-cover"
                loading="eager"
              />
            </picture>
          </div>

          <!-- Foreground Screenshot: Flutter Course Mobile -->
          <div class="absolute right-2 bottom-0 w-2/5 rounded-xl border border-[#334155] bg-[#111827] shadow-2xl overflow-hidden scroll-reveal-front z-10">
            <div class="px-2.5 py-1.5 bg-[#0b0f19] border-b border-[#1e293b] flex items-center justify-between">
              <span class="text-[9px] text-[#94a3b8] font-mono">Flutter & Android</span>
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            </div>
            <picture>
              <source srcset="/images/courses/flutter-mobile.avif" type="image/avif" />
              <source srcset="/images/courses/flutter-mobile.webp" type="image/webp" />
              <img
                src="/images/courses/flutter-mobile.png"
                alt="Real screenshot of Karmatix Flutter Course mobile layout"
                width="600"
                height="1298"
                class="w-full h-auto object-cover"
                loading="eager"
              />
            </picture>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

