---
---

<section id="tools" class="py-16 md:py-24 border-b border-[#1e293b]">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#1e293b] bg-[#111827] px-3 py-1 text-xs font-semibold text-[#60a5fa] mb-3">
        <span>LEARNING TOOLS</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#f8fafc] tracking-tight">
        Built-in utilities to accelerate your study pace.
      </h2>
      <p class="mt-2 text-sm sm:text-base text-[#94a3b8] max-w-2xl">
        Every tool is built directly into our courses to keep you consistent without external subscriptions.
      </p>
    </div>

    <!-- Asymmetric 2-Column Block -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Tool 1: 30/60/90 Day Study Planner (7 cols) -->
      <div class="lg:col-span-7 flex flex-col justify-between rounded-lg border border-[#1e293b] bg-[#111827] p-6 sm:p-8 hover:border-[#334155] transition-colors">
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#2563eb]/20 px-3 py-1 text-xs font-semibold text-[#60a5fa] border border-[#2563eb]/30">
              Interactive Tool
            </span>
            <span class="text-xs text-[#64748b] font-mono">Integrated in Flutter Course</span>
          </div>

          <h3 class="text-2xl font-bold text-[#f8fafc] mb-3">
            30, 60, and 90-Day Study Planner
          </h3>
          <p class="text-sm sm:text-base text-[#94a3b8] leading-relaxed mb-6">
            A dynamic schedule generator that adapts your milestone roadmap to your available daily hours. Features custom exam countdowns, daily target checklists, and milestone reminders.
          </p>

          <!-- Screenshot Preview -->
          <div class="rounded-lg overflow-hidden border border-[#1e293b] bg-[#0b0f19] mb-6">
            <picture>
              <source srcset="/images/courses/flutter-desktop.avif" type="image/avif" />
              <source srcset="/images/courses/flutter-desktop.webp" type="image/webp" />
              <img
                src="/images/courses/flutter-desktop.png"
                alt="Interactive Study Planner preview in Karmatix Flutter Course"
                width="1200"
                height="750"
                class="w-full h-auto object-cover opacity-90 hover:opacity-100 transition-opacity"
                loading="lazy"
              />
            </picture>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-[#1e293b]">
          <span class="text-xs text-[#64748b]">Lives inside Karmatix Flutter Course</span>
          <a
            href="https://karma-tic.github.io/flutter-course/"
            class="inline-flex h-10 items-center justify-center rounded-full bg-[#2563eb] px-5 text-xs font-semibold text-white transition-colors hover:bg-[#1d4ed8]"
          >
            Open study planner &rarr;
          </a>
        </div>
      </div>

      <!-- Tool 2: Free Resource Library & Cheat Sheets (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between rounded-lg border border-[#1e293b] bg-[#111827] p-6 sm:p-8 hover:border-[#334155] transition-colors">
        <div>
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/20 px-3 py-1 text-xs font-semibold text-emerald-400 border border-emerald-500/30">
              Reference Guides
            </span>
            <span class="text-xs text-[#64748b] font-mono">Integrated in .NET Academy</span>
          </div>

          <h3 class="text-2xl font-bold text-[#f8fafc] mb-3">
            Developer Resource Library
          </h3>
          <p class="text-sm text-[#94a3b8] leading-relaxed mb-6">
            Curated syntax cheat sheets for C# 14, LINQ operations, EF Core migrations, and Docker configurations. Includes printable summaries and offline study notes.
          </p>

          <!-- Screenshot Preview -->
          <div class="rounded-lg overflow-hidden border border-[#1e293b] bg-[#0b0f19] mb-6">
            <picture>
              <source srcset="/images/courses/dotnet-desktop.avif" type="image/avif" />
              <source srcset="/images/courses/dotnet-desktop.webp" type="image/webp" />
              <img
                src="/images/courses/dotnet-desktop.png"
                alt="Resource library and cheat sheets inside Karmatix .NET Academy"
                width="1200"
                height="750"
                class="w-full h-auto object-cover opacity-90 hover:opacity-100 transition-opacity"
                loading="lazy"
              />
            </picture>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-[#1e293b]">
          <span class="text-xs text-[#64748b]">Lives inside Karmatix .NET Academy</span>
          <a
            href="https://dotnet.karmatix.in"
            class="inline-flex h-10 items-center justify-center rounded-full border border-[#334155] bg-[#0b0f19] px-5 text-xs font-semibold text-[#f8fafc] transition-colors hover:border-[#60a5fa] hover:text-[#60a5fa]"
          >
            Browse cheat sheets &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
