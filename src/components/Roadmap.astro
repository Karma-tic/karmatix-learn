---
import coursesData from '../data/courses.json';

const plannedCourses = coursesData.filter((c) => c.status === 'planned');
---

<section id="roadmap" class="py-16 md:py-24 border-b border-[#1e293b]">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-[#1e293b] bg-[#111827] px-3 py-1 text-xs font-semibold text-[#60a5fa] mb-3">
          <span>CURRICULUM ROADMAP</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#f8fafc] tracking-tight">
          What we are building next.
        </h2>
        <p class="mt-2 text-sm sm:text-base text-[#94a3b8] max-w-2xl">
          We announce courses only when syllabus research and code validation are underway. No arbitrary release dates.
        </p>
      </div>

      <!-- Suggest a Course Action -->
      <div class="flex items-center gap-3">
        <a
          href="mailto:contact@karmatix.in?subject=Course%20Suggestion%20for%20Karmatix%20Learning"
          class="inline-flex h-11 items-center justify-center rounded-full border border-[#334155] bg-[#111827] px-5 text-xs font-semibold text-[#f8fafc] transition-colors hover:border-[#60a5fa] hover:text-[#60a5fa]"
        >
          <svg class="w-4 h-4 mr-2 text-[#60a5fa]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Suggest a course
        </a>
      </div>
    </div>

    <!-- Calm Horizontal List -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {plannedCourses.map((course, idx) => (
        <div class="flex flex-col justify-between rounded-lg border border-[#1e293b] bg-[#111827] p-6 hover:border-[#334155] transition-colors">
          <div>
            <div class="flex items-center justify-between text-xs mb-3">
              <span class="font-mono text-[#64748b]">PHASE 0{idx + 1}</span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-800 px-2.5 py-0.5 text-[11px] font-medium text-[#94a3b8]">
                <span class="h-1.5 w-1.5 rounded-full bg-[#64748b]"></span>
                In planning
              </span>
            </div>

            <h3 class="text-lg font-bold text-[#f8fafc] mb-2">
              {course.title}
            </h3>
            <p class="text-xs text-[#94a3b8] leading-relaxed mb-4">
              {course.tagline}
            </p>
          </div>

          <div class="pt-4 border-t border-[#1e293b] flex items-center justify-between text-xs">
            <span class="text-[#64748b]">{course.level}</span>
            <span class="text-[#94a3b8] font-mono">No invented dates</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
