---
---

<section id="standard" class="py-16 md:py-24 border-b border-[#1e293b]">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Sticky Left Column -->
      <div class="lg:col-span-5 lg:sticky lg:top-24">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#1e293b] bg-[#111827] px-3 py-1 text-xs font-semibold text-[#60a5fa] mb-3">
          <span>THE KARMATIX STANDARD</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#f8fafc] tracking-tight mb-4">
          Built on principles, verified in automated pipelines.
        </h2>
        <p class="text-sm sm:text-base text-[#94a3b8] leading-relaxed mb-6">
          Most free tutorials teach toy snippets that fail in production. We build full applications, run them through automated test runners, and verify every claim against official documentation.
        </p>
        <div class="hidden lg:block p-4 rounded-lg bg-[#111827] border border-[#1e293b]">
          <div class="text-xs font-semibold text-[#f8fafc] mb-1">Strict Quality Guarantee</div>
          <p class="text-xs text-[#94a3b8]">
            If any code sample fails to compile or any link breaks, our continuous integration gate immediately fails the build.
          </p>
        </div>
      </div>

      <!-- Right Column: Stacked Statements -->
      <div class="lg:col-span-7 flex flex-col gap-8">
        
        <!-- Pillar 1: Production first -->
        <div class="border-l-2 border-[#2563eb] pl-6 py-2">
          <div class="text-xs font-mono font-semibold uppercase tracking-wider text-[#60a5fa] mb-1">Pillar 01</div>
          <h3 class="text-xl sm:text-2xl font-bold text-[#f8fafc] mb-2">Production first</h3>
          <p class="text-sm sm:text-base text-[#94a3b8] leading-relaxed mb-4">
            We teach real-world architectural patterns rather than hello-world shortcuts. Every C# and .NET sample is structured with clean boundaries, Dependency Injection, Dockerfiles, and unit tests.
          </p>
          <div class="inline-flex items-center gap-2 rounded-md bg-[#111827] px-3 py-1.5 border border-[#1e293b] text-xs">
            <span class="text-[#64748b]">Evidence:</span>
            <a
              href="https://github.com/Karma-tic/dotnet-academy/blob/main/.github/workflows/ci.yml"
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-[#60a5fa] hover:underline"
            >
              Verified via GitHub Actions CI with -warnaserror &rarr;
            </a>
          </div>
        </div>

        <!-- Pillar 2: Career ready -->
        <div class="border-l-2 border-[#2563eb] pl-6 py-2">
          <div class="text-xs font-mono font-semibold uppercase tracking-wider text-[#60a5fa] mb-1">Pillar 02</div>
          <h3 class="text-xl sm:text-2xl font-bold text-[#f8fafc] mb-2">Career ready</h3>
          <p class="text-sm sm:text-base text-[#94a3b8] leading-relaxed mb-4">
            Curriculums are tailored directly to Indian company exam patterns and hiring manager expectations. From commercial billing problems to real technical interview questions, learners prepare for real technical rounds.
          </p>
          <div class="inline-flex items-center gap-2 rounded-md bg-[#111827] px-3 py-1.5 border border-[#1e293b] text-xs">
            <span class="text-[#64748b]">Evidence:</span>
            <a
              href="https://karma-tic.github.io/dotnet-academy/"
              class="font-medium text-[#60a5fa] hover:underline"
            >
              200+ interview Q&amp;A and 5 timed mock exams &rarr;
            </a>
          </div>
        </div>

        <!-- Pillar 3: Private by design -->
        <div class="border-l-2 border-[#2563eb] pl-6 py-2">
          <div class="text-xs font-mono font-semibold uppercase tracking-wider text-[#60a5fa] mb-1">Pillar 03</div>
          <h3 class="text-xl sm:text-2xl font-bold text-[#f8fafc] mb-2">Private by design</h3>
          <p class="text-sm sm:text-base text-[#94a3b8] leading-relaxed mb-4">
            We collect zero personal data, execute zero third-party telemetry scripts, and place zero tracking cookies. Course progress and quiz state remain strictly in your browser local storage.
          </p>
          <div class="inline-flex items-center gap-2 rounded-md bg-[#111827] px-3 py-1.5 border border-[#1e293b] text-xs">
            <span class="text-[#64748b]">Evidence:</span>
            <a
              href="/privacy"
              class="font-medium text-[#60a5fa] hover:underline"
            >
              Zero third-party requests and DPDP aligned policy &rarr;
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

