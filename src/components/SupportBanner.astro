---
---

<aside
  id="support-session-banner"
  class="relative z-50 border-b border-[#1e293b] bg-[#0e1422] px-4 py-2.5 text-xs text-[#94a3b8] transition-opacity duration-200"
  role="region"
  aria-label="Community support notice"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-[#2563eb]/20 text-[11px]" aria-hidden="true">
        ☕
      </span>
      <span class="text-[#cbd5e1]">
        Learning for free? Support us on Ko-fi.
      </span>
      <a
        href="https://ko-fi.com/karmatix"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-[#60a5fa] hover:text-[#93c5fd] hover:underline focus:outline-none focus:ring-1 focus:ring-[#2563eb] rounded px-1 transition-colors"
        aria-label="Support Karmatix on Ko-fi (opens in a new tab)"
      >
        Buy me a chai &rarr;
      </a>
      <span class="hidden sm:inline text-[#475569]">&middot;</span>
      <a
        href="/support"
        class="hidden sm:inline text-[#94a3b8] hover:text-[#f8fafc] hover:underline focus:outline-none focus:ring-1 focus:ring-[#2563eb] rounded px-1 transition-colors"
      >
        Why we stay free
      </a>
    </div>

    <button
      id="dismiss-support-banner-btn"
      type="button"
      class="inline-flex h-7 w-7 items-center justify-center rounded-md text-[#94a3b8] hover:bg-[#1e293b] hover:text-[#f8fafc] focus:outline-none focus:ring-1 focus:ring-[#2563eb] transition-colors"
      aria-label="Dismiss support message for this session"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</aside>

<script is:inline>
  (function () {
    var storageKey = 'kx_support_banner_dismissed';
    var banner = document.getElementById('support-session-banner');
    var dismissBtn = document.getElementById('dismiss-support-banner-btn');

    try {
      if (sessionStorage.getItem(storageKey) === 'true') {
        if (banner) {
          banner.style.display = 'none';
        }
      }
    } catch (err) {
      // Storage access blocked or restricted in private browsing mode
    }

    if (dismissBtn && banner) {
      dismissBtn.addEventListener('click', function () {
        try {
          sessionStorage.setItem(storageKey, 'true');
        } catch (err) {
          // Ignore storage errors
        }
        banner.style.display = 'none';
      });
    }
  })();
</script>
