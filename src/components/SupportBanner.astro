---
import Icon from './Icon.astro';
---
<aside id="support-session-banner" class="border-b border-line bg-surface text-xs text-muted" aria-label="Support notice">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <p class="flex min-h-9 flex-wrap items-center gap-x-2">
      <span>Free, no sign-up, no affiliate links.</span>
      <a href="https://ko-fi.com/karmatix" class="inline-flex min-h-9 items-center font-medium text-ember-soft underline-offset-4 hover:underline">Buy us a chai on Ko-fi</a>
      <a href="/support/" class="hidden min-h-9 items-center text-dim underline-offset-4 hover:text-text hover:underline sm:inline-flex">Why we stay free</a>
    </p>
    <button id="dismiss-support-banner-btn" type="button" class="inline-flex size-9 shrink-0 items-center justify-center rounded-full text-dim transition-colors hover:bg-surface-2 hover:text-text" aria-label="Hide this message">
      <Icon name="x" class="size-4" />
    </button>
  </div>
</aside>
<script is:inline>
  (function () {
    var key = 'kx_support_banner_dismissed';
    var banner = document.getElementById('support-session-banner');
    var btn = document.getElementById('dismiss-support-banner-btn');
    try { if (sessionStorage.getItem(key) === 'true' && banner) banner.style.display = 'none'; } catch (e) {}
    if (btn && banner) btn.addEventListener('click', function () { try { sessionStorage.setItem(key, 'true'); } catch (e) {} banner.style.display = 'none'; });
  })();
</script>
