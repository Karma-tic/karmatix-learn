---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found | Karmatix Learn"
  description="The requested page could not be found on Karmatix Learn."
>

  <section class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6 md:py-32">
    <p class="num text-sm text-ember-soft">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-text">This page is not on the map</h1>
    <p id="redirect-notice" class="mt-4 leading-relaxed text-muted">The link may be old or mistyped. If you followed a legacy .NET Academy bookmark, we will forward you there automatically.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/#paths" class="kx-btn kx-btn-primary">Pick a path</a>
      <a href="/resources/" class="kx-btn kx-btn-ghost">Browse resources</a>
    </div>
  </section>

  <!-- Deep Link Forwarding Script for Legacy .NET URLs -->
  <script is:inline>
    (function () {
      var path = window.location.pathname;
      var dotnetPatterns = [
        /^\/module-/,
        /^\/career/,
        /^\/cheatsheets/,
        /^\/certifications/,
        /^\/resources/,
        /^\/glossary/,
        /^\/practice-lab/,
        /^\/curriculum/,
        /^\/exam/
      ];

      var isDotNetRoute = dotnetPatterns.some(function (regex) {
        return regex.test(path);
      });

      if (isDotNetRoute) {
        var notice = document.getElementById('redirect-notice');
        if (notice) {
          notice.textContent = 'Redirecting you to the .NET Academy course...';
        }
        var target = 'https://karma-tic.github.io/dotnet-academy' + (path.startsWith('/') ? path : '/' + path) + window.location.search + window.location.hash;
        window.location.replace(target);
      }
    })();
  </script>
</Layout>
