---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { certifications, res, VERDICT, TRACKS, LAST_CHECKED } from '../../lib/data';
const order: Record<string, number> = { worth: 0, good: 1, only: 2 };
const list = [...certifications].sort((a, b) => order[a.verdict] - order[b.verdict]);
const tone = (v: string) => (v === 'worth' ? 'kx-tag-free' : v === 'only' ? 'kx-tag-paid' : '');
const groups = (['worth', 'good', 'only'] as const).map((v) => ({ v, items: list.filter((c) => c.verdict === v) }));
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'ItemList', name: 'Developer certifications compared', itemListElement: list.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: c.url })) }];
---
<Layout title="Which developer certifications are worth it? Fees and verdicts | Karmatix Learn" description={`An honest verdict on ${certifications.length} developer certifications: AWS, Azure, Google Cloud, Kubernetes, Terraform, Security+, Power BI and more, with exam fees, validity and what to study.`} canonical="https://learn.karmatix.in/certifications/" jsonLd={jsonLd} current="certifications">
  <section class="mx-auto max-w-6xl px-4 pt-14 sm:px-6 sm:pt-20">
    <h1 class="text-4xl font-semibold tracking-[-0.03em] text-text sm:text-5xl">Certifications, honestly rated</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">A certificate never replaces projects, but a few open doors. Here is what each one costs, how long it lasts and whether it is worth your money.</p>
    <div class="mt-8 grid gap-3 sm:grid-cols-3">
      {Object.entries(VERDICT).map(([k, v]) => (
        <div class="kx-card p-4">
          <span class={`kx-tag ${tone(k)}`}>{v.label}</span>
          <p class="mt-2 text-sm text-muted">{v.text}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 flex max-w-3xl gap-2 text-sm text-dim"><Icon name="info" class="mt-0.5 size-4 shrink-0" />Fees are the standard exam price in US dollars, with Indian prices where the provider publishes them. Checked {LAST_CHECKED}. Providers change prices and add tax, so confirm on the official page before you pay.</p>
  </section>

  {groups.map((g) => (
    <section class="mx-auto max-w-6xl px-4 pt-14 sm:px-6" aria-labelledby={`g-${g.v}`}>
      <h2 id={`g-${g.v}`} class="flex items-center gap-3 text-2xl font-semibold tracking-tight text-text"><span class={`kx-tag ${tone(g.v)} !h-7 !px-2.5 !text-sm`}>{VERDICT[g.v].label}</span><span class="num text-base text-dim">{g.items.length}</span></h2>
      <div class="mt-6 grid gap-4 lg:grid-cols-2">
        {g.items.map((c) => (
          <article class="kx-card flex flex-col p-5 sm:p-6" id={c.id}>
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-lg font-semibold leading-snug text-text">{c.name}</h3>
                <p class="mt-0.5 text-sm text-dim">{c.provider} <span aria-hidden="true">/</span> <span class="num">{c.code}</span></p>
              </div>
              <div class="text-right">
                <p class="num text-lg font-semibold text-text">{c.fee}</p>
                {c.feeIndia && <p class="num text-xs text-dim">India: {c.feeIndia}</p>}
              </div>
            </div>
            <p class="mt-3 leading-relaxed text-muted">{c.why}</p>
            {c.note && <p class="mt-3 flex gap-2 rounded-lg bg-surface-2 p-3 text-sm text-muted"><Icon name="info" class="mt-0.5 size-4 shrink-0 text-ember" />{c.note}</p>}
            <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-line pt-4 text-sm">
              <div><dt class="text-xs text-dim">Valid for</dt><dd class="mt-0.5 text-text">{c.validity}</dd></div>
              <div><dt class="text-xs text-dim">Paths</dt><dd class="mt-0.5 text-text">{c.tracks.map((t) => TRACKS[t]).join(', ')}</dd></div>
            </dl>
            <div class="mt-4">
              <p class="text-xs text-dim">Prepare with</p>
              <ul class="mt-2 flex flex-wrap gap-2">
                {c.prep.map((id) => { const r = res(id); return <li><a href={r.url} class="kx-chip">{r.name}</a></li>; })}
              </ul>
            </div>
            <a href={c.url} class="mt-5 inline-flex min-h-11 items-center gap-1.5 self-start text-sm font-medium text-ember-soft underline-offset-4 hover:underline">Official exam page<Icon name="arrow-up-right" class="size-4" /></a>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6" aria-labelledby="skip-h">
    <div class="kx-card p-6 sm:p-8">
      <h2 id="skip-h" class="text-xl font-semibold text-text">Do not pay for these</h2>
      <ul class="mt-4 space-y-3 text-muted">
        <li class="flex gap-3"><Icon name="x" class="mt-1 size-4 shrink-0 text-warn" /><span>Course completion certificates from video platforms. They prove you watched, not that you can build. Put the project on GitHub instead.</span></li>
        <li class="flex gap-3"><Icon name="x" class="mt-1 size-4 shrink-0 text-warn" /><span>Expensive bootcamp certificates sold with a job guarantee. Read the refund terms and ask past students on r/developersIndia first.</span></li>
        <li class="flex gap-3"><Icon name="x" class="mt-1 size-4 shrink-0 text-warn" /><span>Exam dumps. They break the exam rules, can get your certification revoked, and you learn nothing.</span></li>
        <li class="flex gap-3"><Icon name="x" class="mt-1 size-4 shrink-0 text-warn" /><span>The TensorFlow Developer Certificate. Google closed the programme in 2024.</span></li>
      </ul>
    </div>
  </section>
</Layout>
